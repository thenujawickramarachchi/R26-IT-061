APP_NAME=Sri Lankan Dengue NLP API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Use a full absolute path. Forward slashes also work on Windows.
MODEL_ROOT=C:/DengueProject/Dengue_NLP_Model
MODEL_DEVICE=auto

# Set a strong secret before exposing the API outside your own computer.
API_KEY=
ALLOWED_ORIGINS=*

MAX_INPUT_CHARACTERS=4000
CONTEXT_MAX_LENGTH=256
SEQUENCE_MAX_LENGTH=256
RAG_MAX_LENGTH=256
RAG_TOP_K=5

CONTEXT_CONFIDENCE_THRESHOLD=0.70
NLI_CONFIDENCE_THRESHOLD=0.75
RAG_SCORE_THRESHOLD=0.75
SEVERITY_CONFIDENCE_THRESHOLD=0.70

# false gives faster startup and loads the model on the first request.
PRELOAD_CONTEXT_MODEL=false
