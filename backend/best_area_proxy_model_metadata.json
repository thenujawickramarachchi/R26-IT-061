            "district_outbreak_level",
            "moh_dengue_cases",
            "moh_dengue_cases_proxy",
            "moh_outbreak_level_proxy"
        ],
        "allowed_historical_features": [
            "dengue_lag_1",
            "dengue_lag_2",
            "rainfall_lag_1",
            "humidity_lag_1"
        ]
    },
    "validation_strategy": {
