{
    "project": "Machine Learning-Based Dengue Outbreak Prediction System for Colombo District",
    "component": "Data Engineering and Machine Learning Prediction",
    "task": "MOH-area proxy risk classification",
    "target": "area_outbreak_level",
    "features": [
        "year",
        "week",
        "month",
        "rainfall_mm",
        "humidity_pct",
        "temp_max_c",
        "temp_min_c",
        "temp_mean_c",
        "dengue_lag_1",
        "dengue_lag_2",
        "rainfall_lag_1",
        "humidity_lag_1",
        "moh_area"
    ],
    "categorical_feature": "moh_area",
    "categorical_encoding": "OneHotEncoder(handle_unknown='ignore')",
    "target_encoding": {
        "0": "High",
        "1": "Low",
        "2": "Medium"
    },
    "random_state": 42,
    "data_context": {
        "year_range": "2015-2026",
        "2026_available_until_week": 22,
        "moh_areas": 10,
        "note": "MOH-area dengue values are estimated/proxy context values and are not complete official MOH-area surveillance records."
    },
    "leakage_control": {
        "direct_same_period_target_generating_features_used": false,
        "excluded_features": [
            "area_dengue_cases",
